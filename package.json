{
  "name": "flashlet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first browser workbench powered by the Pi coding agent SDK",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node --import tsx --watch --env-file-if-exists=.env server/index.js",
    "start": "node --import tsx --env-file-if-exists=.env server/index.js",
    "test": "node --import tsx --test test/*.test.js test/*.test.ts",
    "check": "tsc --noEmit && node --check server/index.js && node --check server/agent.js && node --check public/app.js",
    "test:ui": "npm run build && node --import tsx test/ui-smoke.mjs && node --import tsx test/connectors-ui.mjs",
    "build": "tsx scripts/build.ts",
    "prestart": "npm run build",
    "predev": "npm run build",
    "test:connectors-ui": "node --import tsx test/connectors-ui.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "dompurify": "3.4.17",
    "express": "5.1.0",
    "highlight.js": "11.12.0",
    "katex": "0.18.10",
    "marked": "18.1.3",
    "marked-katex-extension": "5.1.13",
    "mermaid": "12.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "minimatch": "11.0.4",
    "undici": "8.12.3"
  }
}
