{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "server/**/*.ts",
    "client/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "shared/**/*.ts",
    "client/**/*.tsx"
  ]
}
