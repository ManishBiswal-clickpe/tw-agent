# Node >=22.19.0. All settings are server-side; keys never go to the browser.
PORT=3210
FLASHLET_WORKSPACE=.
FLASHLET_MODEL_BASE_URL=http://127.0.0.1:8080/v1
FLASHLET_MODEL_ID=local-model
# Leave blank for local servers that do not require authentication.
FLASHLET_MODEL_API_KEY=
FLASHLET_CONTEXT_WINDOW=32768
FLASHLET_MAX_TOKENS=4096
# Read-only by default. Opting in enables bash, write and edit with your OS permissions.
FLASHLET_ALLOW_WRITES=false
